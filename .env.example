# Copy to .env and adjust. See README for service mapping.

# PostgreSQL (apps/api — Prisma)
DATABASE_URL=postgresql://storywall:storywall@localhost:5432/storywall

# Redis (apps/worker — BullMQ; future API job enqueue)
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (future: imagery, exports)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=storywall-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# Auth — required for creator JWT (M1-T06). Use a long random string in production.
JWT_SECRET=change-me-in-development-min-32-chars-long
# Access token TTL in seconds (default 604800 = 7 days)
JWT_TTL_SECONDS=604800

# API
PORT=3001

# --- M5-T01 — AI runtime (configuration only; no transport in this milestone) ---
# When unset or not "true", AI runtime is disabled and Storywall uses existing stub/template paths only.
STORYWALL_AI_RUNTIME_ENABLED=false
# Provider wiring for future HTTP transport: `none` (default) or `openai_compatible` (OpenAI-style base URL + API key).
STORYWALL_AI_PROVIDER=none
# Base URL for OpenAI-compatible APIs (example only; set in host secrets for real use in a later M5 ticket).
# STORYWALL_AI_BASE_URL=https://api.openai.com/v1
# API key — set only in deployment secrets, never commit.
# STORYWALL_AI_API_KEY=
# Optional default model label for audit metadata once transport exists.
# STORYWALL_AI_DEFAULT_MODEL=

# Web (Vite) — proxy to API in dev if needed
# VITE_API_URL=http://localhost:3001
# Public site origin for canonical / Open Graph URLs (M4-T01). Falls back to window.location.origin in the browser when unset.
# VITE_PUBLIC_SITE_URL=https://your-domain.example
