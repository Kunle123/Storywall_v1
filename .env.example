# Copy to .env and adjust. See README for service mapping.

# PostgreSQL (apps/api — Prisma)
DATABASE_URL=postgresql://storywall:storywall@localhost:5432/storywall

# Redis (apps/worker — BullMQ; future API job enqueue)
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (future: imagery, exports)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=storywall-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# Auth — required for creator JWT (M1-T06). Use a long random string in production.
JWT_SECRET=change-me-in-development-min-32-chars-long
# Access token TTL in seconds (default 604800 = 7 days)
JWT_TTL_SECONDS=604800

# API
PORT=3001

# --- M5-T01 / M5-T10 / M5-T11 — AI runtime (OpenAI-compatible HTTP when armed) ---
# When unset or not "true", AI runtime is disabled; `POST …/frames/generate` uses deterministic framing fallback;
# `POST …/live-event-draft-enrichment/generate` uses honest deterministic draft mapping or empty failure (M5-T11).
STORYWALL_AI_RUNTIME_ENABLED=false
# Provider: `none` (default) or `openai_compatible` for Chat Completions (M5-T10 live framing + M5-T11 live enrichment when key + base URL set).
STORYWALL_AI_PROVIDER=none
# Example OpenAI: base URL must include `/v1` suffix used by the client.
# STORYWALL_AI_BASE_URL=https://api.openai.com/v1
# STORYWALL_AI_API_KEY=  # host secret only — never commit
# STORYWALL_AI_DEFAULT_MODEL=gpt-4o-mini

# --- M5-T02 — AI runtime operational policy + telemetry ---
# Telemetry sink for execution events (safe JSON; never logs prompts or API keys): `none` (default) or `console`.
# STORYWALL_AI_TELEMETRY_SINK=none
# HTTP timeout ceiling for future transport (ms, clamped 1_000–300_000; default 60_000).
# STORYWALL_AI_HTTP_TIMEOUT_MS=60000
# Max retries for future transport (0–10, default 2).
# STORYWALL_AI_MAX_RETRIES=2
# Sliding-window rate limit when surface is `armed` (enforcement is off when disabled/misconfigured).
# STORYWALL_AI_RATE_LIMIT_WINDOW_MS=60000
# STORYWALL_AI_MAX_CALLS_PER_WINDOW=30

# --- M5-T04 — Bounded retrieval (worker `research.run`; Wikipedia search API only) ---
# When unset or not "true", research uses the M2-T02 stub package (`example.invalid` placeholders).
# STORYWALL_RETRIEVAL_ENABLED=false
# STORYWALL_RETRIEVAL_TIMEOUT_MS=12000
# STORYWALL_RETRIEVAL_MAX_CANDIDATES=4
# STORYWALL_RETRIEVAL_MAX_RESPONSE_BYTES=400000
# STORYWALL_RETRIEVAL_MAX_QUERY_CHARS=240
# Comma-separated API hostnames; must include en.wikipedia.org for the bundled adapter.
# STORYWALL_RETRIEVAL_ALLOWED_API_HOSTS=en.wikipedia.org
# Identify your deployment to Wikimedia (recommended).
# STORYWALL_RETRIEVAL_USER_AGENT=StorywallResearch/1.0 (+https://your-domain.example)

# Web (Vite) — proxy to API in dev if needed
# VITE_API_URL=http://localhost:3001
# Public site origin for canonical / Open Graph URLs (M4-T01). Falls back to window.location.origin in the browser when unset.
# VITE_PUBLIC_SITE_URL=https://your-domain.example
