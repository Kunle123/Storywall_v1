{
  "name": "storywall",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.51.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "db:migrate": "pnpm --filter @storywall/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @storywall/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @storywall/api exec prisma generate",
    "verify:m5-t14": "pnpm --filter @storywall/web run verify:m5-t14",
    "verify:m5-t15": "pnpm --filter @storywall/api run verify:m5-t15",
    "verify:staging:creator-baseline": "node ./scripts/verify-staging-creator-baseline.mjs",
    "verify:staging:research-entry": "node ./scripts/verify-staging-research-entry.mjs",
    "verify:staging:cors-idempotency-header": "node ./scripts/verify-staging-cors-idempotency-header.mjs",
    "verify:staging:research-status": "node ./scripts/verify-staging-research-status.mjs",
    "verify:staging:framing-selection": "node ./scripts/verify-staging-framing-selection.mjs",
    "verify:staging:draft-assembly": "node ./scripts/verify-staging-draft-assembly.mjs",
    "verify:staging:draft-review": "node ./scripts/verify-staging-draft-review-workspace.mjs",
    "verify:staging:canonical-timeline-surfacing": "node ./scripts/verify-staging-canonical-timeline-surfacing.mjs",
    "verify:staging:canonical-retrieval-depth": "node ./scripts/verify-staging-canonical-retrieval-depth.mjs",
    "verify:staging:canonical-synthesis-orchestration": "node ./scripts/verify-staging-canonical-synthesis-orchestration.mjs",
    "verify:staging:canonical-framing-quality": "node ./scripts/verify-staging-canonical-framing-quality.mjs",
    "verify:staging:canonical-event-draft-enrichment": "node ./scripts/verify-staging-canonical-event-draft-enrichment.mjs",
    "verify:staging:canonical-provenance-truthfulness": "node ./scripts/verify-staging-canonical-provenance-truthfulness.mjs",
    "verify:staging:canonical-fallback-semantics": "node ./scripts/verify-staging-canonical-fallback-semantics.mjs",
    "verify:staging:canonical-ux-copy-honesty": "node ./scripts/verify-staging-canonical-ux-copy-honesty.mjs",
    "verify:staging:canonical-ui-parity": "node ./scripts/verify-staging-canonical-ui-parity.mjs",
    "verify:staging:draft-editing": "node ./scripts/verify-staging-draft-editing.mjs",
    "verify:staging:validation-checks": "node ./scripts/verify-staging-validation-checks.mjs",
    "verify:staging:publish-flow": "node ./scripts/verify-staging-publish-flow.mjs",
    "verify:staging:live-story-update": "node ./scripts/verify-staging-live-story-update.mjs",
    "verify:staging:published-visibility-transition": "node ./scripts/verify-staging-published-visibility-transition.mjs",
    "verify:staging:unlisted-discovery-feed": "node ./scripts/verify-staging-unlisted-discovery-feed.mjs",
    "verify:staging:homepage-discover-strip": "node ./scripts/verify-staging-homepage-discover-strip.mjs",
    "verify:staging:homepage-reader-clickthrough": "node ./scripts/verify-staging-homepage-reader-clickthrough.mjs",
    "verify:staging:public-story-references": "node ./scripts/verify-staging-public-story-references.mjs"
  }
}
