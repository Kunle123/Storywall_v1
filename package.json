{
  "name": "storywall",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "db:migrate": "pnpm --filter @storywall/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @storywall/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @storywall/api exec prisma generate",
    "verify:m5-t14": "pnpm --filter @storywall/web run verify:m5-t14"
  }
}
